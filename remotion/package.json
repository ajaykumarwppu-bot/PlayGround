{
  "name": "chapter-five-steps",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "compositions": "remotion compositions src/index.ts",
    "vo": ".venv-tts/bin/python scripts/generate_voiceover.py",
    "assets": "node scripts/generate_assets.mjs",
    "seed": "node scripts/seed_timing.mjs",
    "check:duration": "node scripts/check_duration.mjs",
    "render": "remotion render src/index.ts ChapterFiveSteps ../media/chapter-5-steps.mp4 --browser-executable=/usr/bin/google-chrome --chrome-mode=chrome-for-testing --gl=swangle --concurrency=4 --crf=20 --x264-preset=faster --audio-codec=aac --audio-bitrate=192k --sample-rate=48000",
    "render:draft": "remotion render src/index.ts ChapterFiveSteps out/draft.mp4 --browser-executable=/usr/bin/google-chrome --chrome-mode=chrome-for-testing --gl=swangle --concurrency=4 --scale=0.5 --crf=28 --x264-preset=veryfast --audio-codec=aac"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.9.3"
  }
}
